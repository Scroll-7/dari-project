rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // ── Users collection ──────────────────────────────────────────────────────
    // Any authenticated user can read any user profile (needed for search,
    // chat headers, roommate + provider discovery). Only the owner can write.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);

      // ── Comments (reviews) on a user profile ───────────────────────────────
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.rating >= 0
          && request.resource.data.rating <= 5;
        allow update: if isSignedIn()
          && (request.auth.uid == resource.data.authorId || request.auth.uid == uid);
        allow delete: if isSignedIn()
          && (request.auth.uid == resource.data.authorId || request.auth.uid == uid);
      }

      // ── Notifications ──────────────────────────────────────────────────────
      // Created by other users (e.g. when you get a review), only readable
      // / manageable by the profile owner.
      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if isSignedIn() && request.resource.data.type is string;
      }
    }

    // ── Properties (listings) ────────────────────────────────────────────────
    match /properties/{propId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ── Roommate posts ────────────────────────────────────────────────────────
    match /roommatePosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ── Conversations collection ──────────────────────────────────────────────
    // A user can only read/write a conversation they are a participant in.
    match /conversations/{convId} {
      allow read: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() <= 2;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      // ── Messages sub-collection ─────────────────────────────────────────
      match /messages/{msgId} {
        function participants() {
          return get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        }
        allow read: if isSignedIn() && request.auth.uid in participants();
        allow create: if isSignedIn()
          && request.auth.uid in participants()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0;
        allow update: if isSignedIn() && request.auth.uid in participants();
        allow delete: if isSignedIn() && request.auth.uid in participants();
      }
    }

    // ── Service providers ─────────────────────────────────────────────────────
    match /serviceProviders/{providerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.category is string;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && request.auth.uid == resource.data.uid;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0;
        allow update: if isSignedIn()
          && (request.auth.uid == resource.data.authorId || request.auth.uid == resource.data.ownerId);
        allow delete: if isSignedIn()
          && (request.auth.uid == resource.data.authorId || request.auth.uid == resource.data.ownerId);
      }
    }
  }
}
